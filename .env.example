# OpenAI API Key (общий ключ для всех ассистентов)
OPENAI_API_KEY="your_openai_api_key_here"

# Ассистент анализа карточки проекта
PROJECT_ANALYSIS_ASSISTANT_ID="your_project_analysis_assistant_id_here"

# Чат-помощник
CHAT_ASSISTANT_ID="your_chat_assistant_id_here"
CHAT_ASSISTANT_ENABLED=true

# Доступ к приложению
APP_ACCESS_PASSWORD="123"
APP_ACCESS_PASSWORD_HASH="your_optional_secure_password_hash_here"

# Доступ к Advanced Mode 
ADVANCED_ACCESS_PASSWORD="321"
ADVANCED_ACCESS_PASSWORD_HASH="optional_hash_here"

# Источник данных Google Sheets (Таблица должна быть открыта для просмотра: «Все, у кого есть ссылка»)
# Поддерживается как прямая ссылка экспорта в CSV, так и стандартная ссылка в режиме редактирования /edit
GOOGLE_SHEETS_CSV_URL="your_google_sheets_csv_or_edit_url_here"

# Ссылка на внешний справочник KPI из Google Sheets (CSV)
GOOGLE_SHEETS_INDICATOR_DICTIONARY_CSV_URL="your_google_sheets_indicator_dictionary_csv_url_here"

# Токен для импорта/синхронизации (например, из Битрикс24)
APP_INGEST_TOKEN="your_secure_ingest_token_here"

# Настройки хранилища
STORAGE_TYPE="json"
DATA_DIR="./data"

# Серверный порт (необязательно, по умолчанию 3000)
PORT=3000

# Ссылка на развернутое приложение
APP_URL="your_deployed_app_url_here"
